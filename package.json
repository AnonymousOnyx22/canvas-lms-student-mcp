  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnonymousOnyx22/canvas-lms-student-mcp.git"
  },
  "homepage": "https://brightspacemcp.com",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
