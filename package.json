{
  "name": "canvas-lms-student-mcp",
  "version": "0.1.1",
  "description": "Canvas LMS MCP server for students. Read-only access to Canvas courses: due dates, missing work, grades, announcements, syllabus, modules, discussions and calendar events.",
  "type": "module",
  "main": "build/src/index.js",
  "bin": {
    "canvas-lms-student-mcp": "build/src/index.js"
  },
  "files": [
    "build/src",
    "README.md",
    "llms.txt",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/src/index.js', 0o755)\"",
    "test": "vitest run",
    "start": "node build/src/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "canvas lms mcp",
    "canvas lms mcp server",
    "canvas lms",
